rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() &&
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.email == "evil.bobs.JV@gmail.com" && request.auth.token.email_verified == true));
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // Connection Test
    match /test/connection {
      allow read: if true;
    }

    function isValidFoodLog(data) {
      return data.keys().hasAll(['userId', 'timestamp', 'name', 'calories', 'protein', 'carbs', 'fats', 'portion']) &&
             data.keys().hasOnly(['userId', 'timestamp', 'name', 'calories', 'protein', 'carbs', 'fats', 'alcohol', 'portion', 'reasoning', 'imageUrl']) &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() < 250 &&
             data.calories is number && data.calories >= 0 &&
             data.protein is number && data.protein >= 0 &&
             data.carbs is number && data.carbs >= 0 &&
             data.fats is number && data.fats >= 0 &&
             (!('alcohol' in data) || (data.alcohol is number && data.alcohol >= 0)) &&
             data.portion is string && data.portion.size() > 0 &&
             data.timestamp is number &&
             (!('reasoning' in data) || (data.reasoning is string && data.reasoning.size() < 1000)) &&
             (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() < 1000000));
    }

    function isValidWaterLog(data) {
      return data.keys().hasAll(['userId', 'timestamp', 'amount']) &&
             data.keys().hasOnly(['userId', 'timestamp', 'amount']) &&
             data.userId == request.auth.uid &&
             data.amount is number && data.amount > 0 && data.amount < 10000 &&
             data.timestamp is number;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'goals', 'weightHistory']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'goals', 'weightHistory', 'age', 'gender', 'height', 'activityLevel', 'isSetupComplete']) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.displayName is string &&
             data.goals is map &&
             data.goals.keys().hasAll(['calories', 'protein', 'carbs', 'fats', 'water']) &&
             data.weightHistory is list &&
             (!('age' in data) || data.age is number) &&
             (!('gender' in data) || data.gender in ['male', 'female', 'other']) &&
             (!('height' in data) || data.height is number) &&
             (!('activityLevel' in data) || data.activityLevel in ['sedentary', 'lightlyActive', 'moderatelyActive', 'veryActive', 'extraActive']) &&
             (!('isSetupComplete' in data) || data.isSetupComplete is bool);
    }

    // User Profiles
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(uid) && isValidUserProfile(request.resource.data);
      allow delete: if isAdmin();
    }

    // Food Logs
    match /foodLogs/{logId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidFoodLog(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidFoodLog(request.resource.data);
      allow delete: if isDocOwner() || isAdmin();
    }

    // Water Logs
    match /waterLogs/{logId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidWaterLog(request.resource.data);
      allow update: if (isDocOwner() || isAdmin()) && isValidWaterLog(request.resource.data);
      allow delete: if isDocOwner() || isAdmin();
    }
  }
}
